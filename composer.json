{
    "name": "inventario/app",
    "description": "Sistema de inventario de videojuegos",
    "type": "project",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "Inventario\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Inventario\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test-coverage": "phpunit --coverage-html coverage"
    }
}
